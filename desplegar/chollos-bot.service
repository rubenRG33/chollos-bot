[Unit]
Description=Bot de chollos (Wallapop, Vinted, Chollometro) con avisos por Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chollos
WorkingDirectory=/opt/chollos-bot
ExecStart=/usr/bin/python3 /opt/chollos-bot/chollos.py --bucle
Restart=always
RestartSec=30
# Seguridad: el bot solo puede escribir en su carpeta
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chollos-bot

[Install]
WantedBy=multi-user.target
